# dependencies (bun install)
node_modules

# editor / OS
.vscode/
.idea
.DS_Store

# environment files (never commit secrets)
.env*

# source data (contains personal data — never commit)
actual_data/
preview/
*.csv

# dist/ is committed (administrators download it from GitHub), but never
# the files an administrator adds there: exports and backups hold personal data
dist/data/*
!dist/data/.gitkeep
dist/backup/

# local preview config
.claude/
