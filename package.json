{
  "name": "callcenter",
  "private": true,
  "module": "worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "bun run cache:invalidate",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create callcenter",
    "d1:migrate": "echo Y | wrangler d1 migrations apply callcenter",
    "d1:migrate:local": "echo Y | wrangler d1 migrations apply callcenter --local",
    "d1:seed": "wrangler d1 execute callcenter --file=seeds/0002_seed.sql",
    "d1:seed:local": "wrangler d1 execute callcenter --local --file=seeds/0002_seed.sql",
    "user:create": "bun run scripts/create-user.ts",
    "user:create:local": "bun run scripts/create-user.ts --local",
    "cache:invalidate": "bun run scripts/invalidate-cache.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@types/bun": "latest",
    "miniflare": "^4.20260714.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
