{
  "name": "callcenter",
  "private": true,
  "module": "worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node -e \"const fs=require('fs'); const sw=fs.readFileSync('public/sw.js','utf8'); fs.writeFileSync('public/sw.js', sw.replace(/callcenter-v[^']+/, 'callcenter-v'+Date.now()));\"",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create callcenter",
    "d1:migrate": "wrangler d1 migrations apply callcenter",
    "d1:migrate:local": "wrangler d1 migrations apply callcenter --local",
    "d1:seed": "wrangler d1 execute callcenter --file=migrations/0002_seed.sql",
    "d1:seed:local": "wrangler d1 execute callcenter --local --file=migrations/0002_seed.sql",
    "db:gen-seed": "bun run src/generate_seed_sql.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@types/bun": "latest",
    "wrangler": "^4.94.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}

