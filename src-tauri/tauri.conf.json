{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Τηλεφωνικός Κατάλογος",
  "mainBinaryName": "Τηλεφωνικός Κατάλογος",
  "version": "0.1.0",
  "identifier": "gr.gna251.katalogos",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Τηλεφωνικός Κατάλογος",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
